<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GoldLive" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/on_gold</item>
        <item name="colorPrimaryContainer">@color/card_alt</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryContainer">@color/card_alt</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>

    <style name="GoldCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Muted">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
